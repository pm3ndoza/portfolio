---
import "../styles/global.css";
import skillsData from "../data/skills.json";
import projectsData from "../data/projects.json";
import experienceData from "../data/experience.json";
import profileData from "../data/profile.json";
import hobbiesData from "../data/hobbies.json";
import certificationsData from "../data/certifications.json";

const projects = projectsData.projects;
const skills = skillsData.skills;
const experiences = experienceData.experience;
const profile = profileData;
const hobbies = hobbiesData.hobbies;
const certifications = certificationsData.certifications;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name} | Portfolio</title>
  </head>
  <body>
    <header class="topbar">
      <div class="terminal-path">
        <span>pmendoza@githubpages</span>
        <span>~/portfolio</span>
        <span>main</span>
      </div>
      <nav>
        <a href="#home">01. home</a>
        <a href="#skills">02. skills</a>
        <a href="#projects">03. portfolio</a>
        <a href="#experience">04. experience</a>
        <a href="#certifications">05. certs</a>
        <a href="#about">06. about</a>
        <a href="#hobbies">07. gustos</a>
        <a href="#contact">08. contact</a>
      </nav>
    </header>
    <main>
      <section id="home">
        <p class="eyebrow">&gt; 01. home</p>
        <p>&gt; cat whoami.txt</p>

        <div class="hero-layout">
          <div class="hero-copy">
            <h1>{profile.name}</h1>
            <p class="role">{profile.role}</p>
            <p>{profile.hero}</p>

            <div class="hero-meta">
              <span>{profile.contact.location}</span>
              <span>{profile.availability}</span>
            </div>

            <div class="hero-actions">
              <a class="button-primary" href="#projects">Ver mi trabajo →</a>
              <a class="button-secondary" href={profile.cvUrl} download>
                Descargar CV ↓
              </a>
            </div>
          </div>

          <aside class="hero-terminal">
            <div class="terminal-window-bar">
              <span></span>
              <span></span>
              <span></span>
              <p>~/sys/about.me</p>
            </div>

            <div class="terminal-info">
              <p><strong>OS:</strong> Ubuntu</p>
              <p><strong>Shell:</strong> zsh</p>
              <p><strong>Editor:</strong> vim</p>
              <p><strong>User:</strong> pmendoza@githubpages</p>
              <p><strong>Role:</strong> {profile.role}</p>
              <p><strong>Location:</strong> {profile.contact.location}</p>
              <p><strong>Status:</strong> {profile.availability}</p>
            </div>
          </aside>
        </div>
      </section>


      <section id="skills">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 02. skills</p>
          <p class="section-status">
            &gt; {skills.length} skill groups cargados... aprendizaje continuo
          </p>
        </div>
        <p>&gt; ls skills/</p>
        <div class="cards-grid skills-grid">
          {
            skills.map((skill) => (
              <article>
                <div class="skill-heading">
                  <img
                    class="skill-icon"
                    src={skill.icon}
                    alt=""
                    loading="lazy"
                  />
                  <h2>{skill.title}</h2>
                </div>
                <ul>
                  {skill.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="card-command">&gt; {skill.command}</p>
              </article>
            ))
          }
        </div>
      </section>



	  <section id="projects">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 03. portfolio</p>
          <p class="section-count">{projects.length} projects</p>
        </div>

        <p>&gt; ls projects/</p>
        <div class="cards-grid projects-grid">
          {
            projects.map((project) => (
              <article class="project-card">
                <div class="project-window-bar">
                  <span></span>
                  <span></span>
                  <span></span>

                  <p>project.preview</p>
                </div>

                <div class="project-content">
                  <h2>{project.title}</h2>
                  <p>{project.description}</p>

                  <div class="project-tags">
                    {project.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>

                  <img
                    class="project-preview"
                    src={project.image}
                    alt={`Preview de ${project.title}`}
                    loading="lazy"
                  />

                  <a
                    class="card-command"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    &gt; {project.command}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
      <section id="experience">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 04. Experiencia Laboral</p>
          <p class="section-count">{experiences.length} jobs</p>
        </div>
        <div class="section-header">
          <p>&gt; cat experience.log</p>
        </div>

        <div class="experience-log">
          {
            experiences.map((experience) => (
              <article class="log-item">
                <div class="log-dot" />
                <p class="period">{experience.period}</p>
                <div class="log-role">
                  <h2>{experience.role}</h2>
                  <p class="company">{experience.company}</p>
                </div>
                <p>{experience.description}</p>
                <div class="tags">
                  {experience.tags.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
                <details class="experience-detail">
                  <summary>ver highlights</summary>
                  <ul class="highlights-list">
                    {experience.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </details>
              </article>
            ))
          }
        </div>
      </section>

      <section id="certifications">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 05. certificaciones</p>
          <p class="section-count">{certifications.length} certs</p>
        </div>

        <p>&gt; ls certificates/</p>

        <div class="cards-grid certs-grid">
          {
            certifications.map((certification) => (
              <article class="cert-card">
                <p class="cert-issuer">{certification.issuer}</p>
                <h2>{certification.name}</h2>
                <p>{certification.year}</p>
                <a
                  class="card-command"
                  href={certification.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  &gt; {certification.command}
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section id="about">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 06. about me</p>
        </div>

        <p>&gt; cat about.me</p>

        <div class="about-layout">
          <pre
            class="ascii-art">
-------===========-:::-=============--------
-------=========-:::::::-============--------
-----==========-::::::::::==============-----
---============--=-==-:::::=+++===========---
--=========++++===::::::::::::=+++==========-
=========+++=-:::::::::::::::::-++++=========
=======+++=-:::::::::::::::::::::=++++=======
======++=::::::::::::::::::::::::::-=++======
=====+=-:--=========--::===-===---==--=+=====
==--:::--===========::::::-==========-::::--=
=:::::::-==========:-::::-:==========--:-::::
-::-::----===-=---==--::::-==--==-===--:--:::
:::-:::-:-==-:-=====-=========--::===::::::::
::::::::--==========:---::==========--:::::::
::::::::=-==========-:::::==========-=:::::::
--:--==----==========--:-==========---:-=--:-
==--===-=--===========::==========-::-=====-=
==-:=====--==========::::========-::-======-=
=-::-===-=--===========-=========::-=====--::
-:---====----=========---=====----:--=====:::
:::--======-::-=====----==--:-==-::=-====--::
:::---=----::--:--==--:::::-==-:------------:
:::-----:-:::-====---:::--==---=-::-----:::::
:::-------:::::-=====---==---=-::::::--::::::
::::::--:::-:::::--=---:::-=--::-::::::::::::
		</pre>

          <div>
            {profile.about.map((item) => <p>{item}</p>)}

            <p class="card-command">&gt; echo "{profile.summary}"</p>
          </div>
        </div>
      </section>

      <section id="hobbies" class="crew-section">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 07. gustos / preferencias</p>
          <p class="section-count">crew log</p>
        </div>

        <p>&gt; cat crew.log</p>

        <div class="cards-grid hobbies-grid">
          {
            hobbies.map((hobby) => (
              <article class="hobby-card">
                <p class="hobby-tag">{hobby.tag}</p>
                <h2>{hobby.title}</h2>
                <p>{hobby.description}</p>
              </article>
            ))
          }
        </div>
      </section>


      <section id="contact">
        <div class="section-title-row">
          <p class="eyebrow">&gt; 08. contact</p>
          <p class="section-count">let's connect</p>
        </div>
        <p>&gt; ./contact.sh</p>

        <div class="contact-layout">
          <div class="contact-card">
            <p>Email: {profile.contact.email}</p>
            <p>GitHub: {profile.contact.github}</p>
            <p>LinkedIn: {profile.contact.linkedin}</p>
            <p>Ubicación: {profile.contact.location}</p>
          </div>

          <form class="contact-form">
            <label>
              nombre:
              <input type="text" />
            </label>

            <label>
              email:
              <input type="email" />
            </label>

            <label>
              mensaje:
              <textarea></textarea>
            </label>

            <button type="button">enviar mensaje &gt;</button>
          </form>
        </div>
      </section>
    </main>
    <footer class="footer-bar">
      <div class="terminal-path">
        <span>pmendoza@githubpages</span>
        <span>~/portfolio</span>
        <span>main</span>
      </div>

      <p>"{profile.summary}"</p>
    </footer>
  </body>
</html>
